<Window x:Class="WpfComponentsUITests.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:WpfComponents="clr-namespace:WpfComponents;assembly=WpfComponents"
        mc:Ignorable="d"
        Title="MainWindow" Height="150" Width="600">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Row 0: CheckedMonthYearPicker -->
        <Label Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Content="Checked Month Year Picker:"/>
        <WpfComponents:CheckedMonthYearPicker x:Name="CheckedMonthYearPicker"
                                    Grid.Row="0" Grid.Column="1"
                                    Margin="2"/>
        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Vertical">
            <TextBlock Text="{Binding ElementName=CheckedMonthYearPicker, Path=IsChecked, StringFormat=IsChecked: {0}}"/>
            <TextBlock Text="{Binding ElementName=CheckedMonthYearPicker, Path=SelectedDate, StringFormat=SelectedDate: {0:yyyy-MM-dd}}"/>
        </StackPanel>

        <!-- Row 1: CheckedDatePicker -->
        <Label Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Content="Checked Date Picker:"/>
        <WpfComponents:CheckedDatePicker Name="CheckedDatePicker" 
                                         Grid.Row="1" Grid.Column="1" 
                                         Margin="2"  />
        <!--IsChecked="{Binding Filters.DataRaportuOd.IsChecked}" SelectedDate="{Binding Filters.DataRaportuOd.SelectedValue}"/>-->
        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Vertical">
            <TextBlock Text="{Binding ElementName=CheckedDatePicker, Path=IsChecked, StringFormat=IsChecked: {0}}"/>
            <TextBlock Text="{Binding ElementName=CheckedDatePicker, Path=SelectedDate, StringFormat=SelectedDate: {0:yyyy-MM-dd}}"/>
        </StackPanel>
    </Grid>
</Window>
