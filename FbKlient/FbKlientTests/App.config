<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="DataBase" value="/db/test_fbklient.fdb"/>
    <add key="DataBaseUsr" value="SYSDBA"/>
    <add key="DataBasePwd" value="[databasepassword]"/>
    <add key="DataBaseIp" value="localhost"/>
    <add key="DataBasePort" value="3050"/>
    <add key="DataBaseServerType" value="0"/>
    <add key="DataBasePacket_Size" value="8192"/>
  </appSettings>
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/></startup></configuration>
